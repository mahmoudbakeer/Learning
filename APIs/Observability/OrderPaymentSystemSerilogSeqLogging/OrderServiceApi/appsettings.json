{
  "ConnectionStrings": {
    "Default": "Server=host.docker.internal;Database=OrderServiceApi;User Id=MAHMOUD;Password=sa123456;TrustServerCertificate=True;"
  },

  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverurl": "http://ops-seq:5341" } }
    ],
    "Enrich": ["WithMachineName", "FromLogContext", "WithThreadid"],
    "Properties": {
      "Application": "orderservice"
    }
  },
  "AllowedHosts": "*",
  "PaymentService": {
    "BaseUrl": "http://paymentservice"
  }
}
